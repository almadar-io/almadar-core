{
  "name": "@almadar/core",
  "version": "10.84.0",
  "description": "Core schema types and definitions for Almadar",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "import": "./dist/factory/index.js",
      "require": "./dist/factory/index.js"
    },
    "./factory-runtime": {
      "types": "./dist/factory-runtime/index.d.ts",
      "import": "./dist/factory-runtime/index.js",
      "require": "./dist/factory-runtime/index.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine/index.d.ts",
      "import": "./dist/state-machine/index.js",
      "require": "./dist/state-machine/index.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js",
      "require": "./dist/builders.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js",
      "require": "./dist/patterns/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js",
      "require": "./dist/mock/index.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*",
      "import": "./dist/patterns/*",
      "require": "./dist/patterns/*"
    }
  },
  "files": [
    "dist",
    "src/types/bindings.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.17.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.0.0",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-core.git",
    "directory": "docs/packages/core"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "orbital",
    "schema",
    "types"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3"
}
